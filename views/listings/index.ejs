<% layout("/layouts/boilerplate.ejs") %>

<!--<h1>All listings</h1>
<form method="GET" action="/listings/new">
      <button>Create New Listing</button>
    </form>-->
    <style>
#filters{
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.filter-link{
  text-decoration: none;
  color: inherit;
}
.filter{
  text-align: center;
  margin-right: 2rem;
  margin-top: 2rem;
  opacity: 0.7;
  padding-bottom: 0.2rem;
  transition: all 0.2s ease;
}
.filter:hover{
  opacity: 1;
  cursor: pointer;
}
.filter.active {
  opacity: 1;
  border-bottom: 2px solid black;
  font-weight: 600;
}
.filter p{
  font-size: 0.8rem;
  margin-bottom: 0;
}
.tax-info{
  display: none;
}
.tax-toggle{
  border: 1px solid black;
  border-radius: 1rem;
  height: 3.25rem;
  padding: 1rem;
  margin-left: 3rem;
  display: flex;
  align-items: center;
}
    </style>
    <div id ="filters">
      <a href="<%= activeCategory === 'Trending' ? '/listings' : '/listings?category=Trending' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Trending' ? 'active' : '' %>">
          <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending</p> 
        </div>
      </a>
      <a href="<%= activeCategory === 'Rooms' ? '/listings' : '/listings?category=Rooms' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Rooms' ? 'active' : '' %>">
          <div><i class="fa-solid fa-bed"></i></div>
          <p>Rooms</p> 
        </div>
      </a>
      <a href="<%= activeCategory === 'Iconic cities' ? '/listings' : '/listings?category=Iconic cities' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Iconic cities' ? 'active' : '' %>">
          <div><i class="fa-solid fa-mountain-city"></i></div>
          <p>Iconic cities</p> 
        </div>
      </a>
      <a href="<%= activeCategory === 'Mountains' ? '/listings' : '/listings?category=Mountains' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Mountains' ? 'active' : '' %>">
          <div><i class="fa-solid fa-mountain"></i></div>
          <p>Mountains</p> 
        </div>
      </a>
      <a href="<%= activeCategory === 'Castles' ? '/listings' : '/listings?category=Castles' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Castles' ? 'active' : '' %>">
          <div><i class="fa-brands fa-fort-awesome"></i></div>
          <p>Castles</p> 
        </div>
      </a>
      <a href="<%= activeCategory === 'Pools' ? '/listings' : '/listings?category=Pools' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Pools' ? 'active' : '' %>">
          <div><i class="fa-solid fa-person-swimming"></i></div>
          <p>Pools</p> 
        </div>
      </a>
      <a href="<%= activeCategory === 'Camping' ? '/listings' : '/listings?category=Camping' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Camping' ? 'active' : '' %>">
          <div><i class="fa-solid fa-campground"></i></div>
          <p>Camping</p> 
        </div>
      </a>
      <a href="<%= activeCategory === 'Farms' ? '/listings' : '/listings?category=Farms' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Farms' ? 'active' : '' %>">
          <div><i class="fa-solid fa-cow"></i></div>
          <p>Farms</p> 
        </div>
      </a>
      <a href="<%= activeCategory === 'Arctic' ? '/listings' : '/listings?category=Arctic' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Arctic' ? 'active' : '' %>">
          <div><i class="fa-solid fa-snowflake"></i></div>
          <p>Arctic</p> 
        </div>
      </a>
      <a href="<%= activeCategory === 'Domes' ? '/listings' : '/listings?category=Domes' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Domes' ? 'active' : '' %>">
          <div><i class="fa-solid fa-igloo"></i></div>
          <p>Domes</p> 
        </div>
      </a>
      <a href="<%= activeCategory === 'Breakfast' ? '/listings' : '/listings?category=Breakfast' %>" class="filter-link">
        <div class="filter <%= activeCategory === 'Breakfast' ? 'active' : '' %>">
          <div><i class="fa-solid fa-mug-saucer"></i></div>
          <p>Breakfast</p> 
        </div>
      </a>
      
      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
          <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
      </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
<% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
<div class="card col listing-card">
  <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" height="200rem" />
  <div class="card-body">
    <div class="card-img-overlay"></div>
    <p class="card-text">
       <b><%= listing.title %></b> <br>
         &#8377;<%= listing.price.toLocaleString("en-IN")%>/night<br>
         <i class ="tax-info"> &nbsp; &nbsp; +18% GST</i>
    </p>
  </div>
</div></a>
    <% } %>  
    </div>


    <script>

      let taxSwitch = document.getElementById("switchCheckDefault");
      taxSwitch.addEventListener("click", ()=>{ 
      let taxInfo = document.getElementsByClassName("tax-info");
      for(info of taxInfo){
        if(info.style.display != "inline"){
            info.style.display = "inline";
        }
        else{
          info.style.display = "none";
        }
      }
    
    });

    </script>

