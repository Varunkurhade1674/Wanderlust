<% layout("/layouts/boilerplate.ejs") %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="listing-detail-container my-4">
  <!-- Detail Header -->
  <div class="row mb-3">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item"><a href="/listings" class="text-decoration-none text-muted">Explore</a></li>
          <% if (listing.category) { %>
            <li class="breadcrumb-item"><a href="/listings?category=<%= listing.category %>" class="text-decoration-none text-muted"><%= listing.category %></a></li>
          <% } %>
          <li class="breadcrumb-item active" aria-current="page"><%= listing.title %></li>
        </ol>
      </nav>

      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <h2 class="detail-title mb-1"><%= listing.title %></h2>
          <p class="text-muted mb-0">
            <i class="fa-solid fa-location-dot text-danger me-1"></i>
            <%= listing.location %>, <%= listing.country %>
            <span class="mx-2">&bull;</span>
            <span class="badge bg-light text-dark border">
              <i class="fa-solid fa-star text-warning me-1"></i> 4.9 (<%= listing.reviews ? listing.reviews.length : 0 %> reviews)
            </span>
          </p>
        </div>

        <div class="d-flex gap-2">
          <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');">
            <i class="fa-solid fa-arrow-up-from-bracket me-1"></i> Share
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Detail Content Grid -->
  <div class="row g-4">
    <!-- Left Column: Image, Info, Amenities, Reviews, Map -->
    <div class="col-lg-8">
      <!-- Main Hero Image -->
      <div class="detail-img-box mb-4 position-relative">
        <img 
          src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e' %>" 
          class="img-fluid w-100 detail-hero-img" 
          alt="<%= listing.title %>"
        />
        <% if (listing.category) { %>
          <span class="badge category-chip-badge position-absolute top-0 start-0 m-3 fs-6">
            <%= listing.category %>
          </span>
        <% } %>
      </div>

      <!-- Host & Description Card -->
      <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
        <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-3">
          <div class="d-flex align-items-center gap-3">
            <div class="user-avatar-lg">
              <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : "H" %>
            </div>
            <div>
              <h5 class="mb-0 fw-bold">Hosted by <%= listing.owner ? listing.owner.username : "Host" %></h5>
              <small class="text-muted"><i class="fa-solid fa-shield-halved text-success me-1"></i> Verified Wanderlust Host</small>
            </div>
          </div>
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
            Superhost
          </span>
        </div>

        <h5 class="fw-bold mb-2">About this place</h5>
        <p class="listing-description text-secondary mb-4 leading-relaxed">
          <%= listing.description %>
        </p>

        <!-- Perks / Highlights -->
        <h5 class="fw-bold mb-3">What this place offers</h5>
        <div class="row g-3 mb-2">
          <div class="col-sm-6 d-flex align-items-center gap-3">
            <i class="fa-solid fa-wifi text-danger fs-5"></i>
            <span>Fast high-speed Wi-Fi (150 Mbps)</span>
          </div>
          <div class="col-sm-6 d-flex align-items-center gap-3">
            <i class="fa-solid fa-square-parking text-danger fs-5"></i>
            <span>Free dedicated parking on premises</span>
          </div>
          <div class="col-sm-6 d-flex align-items-center gap-3">
            <i class="fa-solid fa-snowflake text-danger fs-5"></i>
            <span>Central air conditioning & heating</span>
          </div>
          <div class="col-sm-6 d-flex align-items-center gap-3">
            <i class="fa-solid fa-kitchen-set text-danger fs-5"></i>
            <span>Fully equipped chef's kitchen</span>
          </div>
        </div>
      </div>

      <!-- Owner Actions (Edit / Delete) -->
      <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)){ %>
        <div class="card border-0 bg-light p-3 rounded-4 mb-4">
          <div class="d-flex align-items-center justify-content-between">
            <span class="fw-semibold text-secondary">
              <i class="fa-solid fa-gear me-1"></i> Manage your listing:
            </span>
            <div class="d-flex gap-2">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
              </a>
              <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                <button class="btn btn-danger btn-sm rounded-pill px-3">
                  <i class="fa-solid fa-trash-can me-1"></i> Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Reviews Section -->
      <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
        <h4 class="fw-bold mb-3">
          <i class="fa-solid fa-star text-warning me-1"></i>
          Guest Reviews (<%= listing.reviews ? listing.reviews.length : 0 %>)
        </h4>

        <% if (currUser) { %>
          <div class="add-review-box p-3 bg-light rounded-3 mb-4">
            <h5 class="fw-semibold mb-3">Leave a Review</h5>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
              <div class="mb-3">
                <label for="rating" class="form-label fw-medium">Your Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>

              <div class="mb-3">
                <label for="comment" class="form-label fw-medium">Your Feedback</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control rounded-3" placeholder="What did you love about this stay?" required></textarea>
                <div class="invalid-feedback">Please share a few words about your experience.</div>
              </div>

              <button class="btn btn-primary-custom rounded-pill px-4">Submit Review</button>
            </form>
          </div>
        <% } else { %>
          <div class="alert alert-light border rounded-3 text-center mb-4">
            <a href="/login" class="fw-semibold text-danger text-decoration-none">Log in</a> to share your review of this stay.
          </div>
        <% } %>

        <!-- Reviews List -->
        <% if(listing.reviews && listing.reviews.length > 0) { %>
          <div class="row g-3">
            <% for (review of listing.reviews) { %>
              <div class="col-md-6">
                <div class="card h-100 border rounded-3 p-3 bg-white review-card">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <div class="review-avatar">
                        <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : "U" %>
                      </div>
                      <div>
                        <h6 class="mb-0 fw-bold">@<%= review.author ? review.author.username : "guest" %></h6>
                        <small class="text-muted">Verified Guest</small>
                      </div>
                    </div>
                    <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="d-inline">
                        <button class="btn btn-link text-danger p-0 border-0" title="Delete review">
                          <i class="fa-regular fa-trash-can"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                  <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                  <p class="text-secondary small mb-0"><%= review.comment %></p>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p class="text-muted mb-0">No reviews yet. Be the first to review this place!</p>
        <% } %>
      </div>

      <!-- Map Section -->
      <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
        <h4 class="fw-bold mb-3">
          <i class="fa-solid fa-map-location-dot text-danger me-2"></i>Where you'll be
        </h4>
        <p class="text-muted mb-3"><%= listing.location %>, <%= listing.country %></p>
        <div id="map" class="rounded-4 overflow-hidden border"></div>
      </div>
    </div>

    <!-- Right Column: Sticky Booking Widget -->
    <div class="col-lg-4">
      <div class="sticky-top booking-card-wrapper" style="top: 6.5rem;">
        <div class="card border-0 shadow-lg rounded-4 p-4 booking-card">
          <div class="d-flex justify-content-between align-items-baseline mb-3">
            <div>
              <span class="fs-3 fw-bold">&#8377;<%= Number(listing.price || 0).toLocaleString("en-IN") %></span>
              <span class="text-muted"> / night</span>
            </div>
            <div class="small">
              <i class="fa-solid fa-star text-warning"></i>
              <span class="fw-bold">4.9</span>
              <span class="text-muted">(<%= listing.reviews ? listing.reviews.length : 0 %>)</span>
            </div>
          </div>

          <!-- Date Picker Box -->
          <div class="booking-dates-box border rounded-3 p-2 mb-3 bg-light">
            <div class="row g-0">
              <div class="col-6 border-end pe-2">
                <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.65rem;">Check-in</small>
                <input type="date" class="form-control form-control-sm border-0 bg-transparent p-0" id="checkInDate" />
              </div>
              <div class="col-6 ps-2">
                <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.65rem;">Checkout</small>
                <input type="date" class="form-control form-control-sm border-0 bg-transparent p-0" id="checkOutDate" />
              </div>
            </div>
          </div>

          <!-- Guests Selector -->
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.65rem;">Guests</label>
            <select class="form-select rounded-3">
              <option selected>1 guest</option>
              <option>2 guests</option>
              <option>3 guests</option>
              <option>4+ guests</option>
            </select>
          </div>

          <!-- Reserve Button -->
          <button class="btn btn-primary-custom w-100 py-3 rounded-pill fw-bold mb-3 shadow-sm reserve-btn" onclick="alert('Reservation request simulated! Wanderlust is ready for bookings.');">
            Reserve Now
          </button>
          <p class="text-center text-muted small mb-3">You won't be charged yet</p>

          <!-- Price Calculation Breakdown -->
          <div class="price-breakdown border-top pt-3 small text-secondary">
            <div class="d-flex justify-content-between mb-2">
              <span>&#8377;<%= Number(listing.price || 0).toLocaleString("en-IN") %> &times; 3 nights</span>
              <span>&#8377;<%= (Number(listing.price || 0) * 3).toLocaleString("en-IN") %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Cleaning fee</span>
              <span>&#8377;500</span>
            </div>
            <div class="d-flex justify-content-between mb-3">
              <span>Wanderlust service fee (18% GST)</span>
              <span>&#8377;<%= Math.round(Number(listing.price || 0) * 3 * 0.18).toLocaleString("en-IN") %></span>
            </div>
            <div class="d-flex justify-content-between border-top pt-2 fw-bold text-dark fs-6">
              <span>Total before taxes</span>
              <span>&#8377;<%= Math.round((Number(listing.price || 0) * 3 * 1.18) + 500).toLocaleString("en-IN") %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/map.js"></script>
<script>
  // Set default check-in and checkout dates
  const today = new Date();
  const checkIn = new Date(today);
  checkIn.setDate(today.getDate() + 2);
  const checkOut = new Date(today);
  checkOut.setDate(today.getDate() + 5);

  const formatDate = d => d.toISOString().split('T')[0];
  const inElem = document.getElementById('checkInDate');
  const outElem = document.getElementById('checkOutDate');
  if (inElem) inElem.value = formatDate(checkIn);
  if (outElem) outElem.value = formatDate(checkOut);
</script>