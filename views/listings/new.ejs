<% layout("/layouts/boilerplate.ejs") %>

<div class="row justify-content-center my-4">
  <div class="col-lg-8 col-md-10">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
      <h3 class="fw-bold mb-4">Create A New Listing</h3>
      <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input name="listing[title]" placeholder="e.g. Luxury Beachside Villa in North Goa" type="text" class="form-control rounded-3" required>
          <div class="valid-feedback">Title Looks Good!</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea name="listing[description]" placeholder="Describe the atmosphere, views, and special features of your stay..." class="form-control rounded-3" rows="4" required></textarea>
          <div class="invalid-feedback">Please enter a short description</div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label fw-semibold">Upload Image</label>
          <input name="listing[image]" type="file" class="form-control rounded-3" required>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label for="price" class="form-label fw-semibold">Price (&#8377; / night)</label>
            <input name="listing[price]" placeholder="2500" type="number" class="form-control rounded-3" required>
            <div class="invalid-feedback">Price should be valid</div>
          </div>
          <div class="col-md-8">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input name="listing[country]" placeholder="India" type="text" class="form-control rounded-3" required>
            <div class="invalid-feedback">Country name should be valid</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label fw-semibold">Location</label>
          <input name="listing[location]" placeholder="Goa, India" type="text" class="form-control rounded-3" required>
          <div class="invalid-feedback">Location should be valid</div>
        </div>

        <div class="mb-4">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select name="listing[category]" class="form-select rounded-3" required>
            <option value="" disabled selected>Select Category</option>
            <option value="Trending">Trending</option>
            <option value="Rooms">Rooms</option>
            <option value="Iconic cities">Iconic cities</option>
            <option value="Mountains">Mountains</option>
            <option value="Castles">Castles</option>
            <option value="Pools">Pools</option>
            <option value="Camping">Camping</option>
            <option value="Farms">Farms</option>
            <option value="Arctic">Arctic</option>
            <option value="Domes">Domes</option>
            <option value="Breakfast">Breakfast</option>
          </select>
          <div class="invalid-feedback">Please select a valid category</div>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-primary-custom rounded-pill px-4 py-2">Create Listing</button>
          <a href="/listings" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
