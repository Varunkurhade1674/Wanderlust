<% layout("/layouts/boilerplate.ejs") %>
<div class="row justify-content-center my-4">
  <div class="col-lg-8 col-md-10">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
      <h3 class="fw-bold mb-4">Edit Your Listing</h3>
      <form method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control rounded-3" required>
          <div class="valid-feedback">Title Looks Good!</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea name="listing[description]" class="form-control rounded-3" rows="4" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter short description</div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold d-block">Original Listing Image</label>
          <img src="<%= originalImageUrl %>" class="rounded-3 shadow-sm border" style="max-height: 180px; object-fit: cover;" alt="Current image" />
        </div>

        <div class="mb-3">
          <label for="image" class="form-label fw-semibold">Upload New Image</label>
          <input name="listing[image]" type="file" class="form-control rounded-3">
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label for="price" class="form-label fw-semibold">Price (&#8377; / night)</label>
            <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control rounded-3" required>
            <div class="invalid-feedback">Price should be valid</div>
          </div>
          <div class="col-md-8">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control rounded-3" required>
            <div class="invalid-feedback">Country name should be valid</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label fw-semibold">Location</label>
          <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control rounded-3" required>
          <div class="invalid-feedback">Location should be valid</div>
        </div>

        <div class="mb-4">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select name="listing[category]" class="form-select rounded-3" required>
            <option value="" disabled>Select Category</option>
            <option value="Trending" <%= listing.category === 'Trending' ? 'selected' : '' %>>Trending</option>
            <option value="Rooms" <%= listing.category === 'Rooms' ? 'selected' : '' %>>Rooms</option>
            <option value="Iconic cities" <%= listing.category === 'Iconic cities' ? 'selected' : '' %>>Iconic cities</option>
            <option value="Mountains" <%= listing.category === 'Mountains' ? 'selected' : '' %>>Mountains</option>
            <option value="Castles" <%= listing.category === 'Castles' ? 'selected' : '' %>>Castles</option>
            <option value="Pools" <%= listing.category === 'Pools' ? 'selected' : '' %>>Pools</option>
            <option value="Camping" <%= listing.category === 'Camping' ? 'selected' : '' %>>Camping</option>
            <option value="Farms" <%= listing.category === 'Farms' ? 'selected' : '' %>>Farms</option>
            <option value="Arctic" <%= listing.category === 'Arctic' ? 'selected' : '' %>>Arctic</option>
            <option value="Domes" <%= listing.category === 'Domes' ? 'selected' : '' %>>Domes</option>
            <option value="Breakfast" <%= listing.category === 'Breakfast' ? 'selected' : '' %>>Breakfast</option>
          </select>
          <div class="invalid-feedback">Please select a valid category</div>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-primary-custom rounded-pill px-4 py-2">Save Changes</button>
          <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

