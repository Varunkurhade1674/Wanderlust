<% layout("/layouts/boilerplate.ejs") %>

<div class="row justify-content-center my-5">
  <div class="col-md-6 col-lg-5">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="brand-icon-wrapper mx-auto mb-2" style="width: 48px; height: 48px;">
          <i class="fa-regular fa-compass brand-icon fs-4"></i>
        </div>
        <h3 class="fw-bold">Welcome back</h3>
        <p class="text-muted small">Log in to your Wanderlust account</p>
      </div>

      <form action="/login" method="POST" class="needs-validation" novalidate> 
        <div class="mb-3">
          <label for="username" class="form-label fw-semibold">Username</label>
          <input name="username" id="username" type="text" class="form-control rounded-3" placeholder="Enter username" required>
          <div class="invalid-feedback">Please enter your username.</div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label fw-semibold">Password</label>
          <input name="password" id="password" type="password" class="form-control rounded-3" placeholder="Enter password" required>
          <div class="invalid-feedback">Please enter your password.</div>
        </div>

        <button class="btn btn-primary-custom w-100 py-2 rounded-pill fw-bold mb-3">Log In</button>

        <p class="text-center text-muted small mb-0">
          Don't have an account yet? 
          <a href="/signup" class="text-danger fw-semibold text-decoration-none">Sign up</a>
        </p>
      </form>
    </div>
  </div>
</div>