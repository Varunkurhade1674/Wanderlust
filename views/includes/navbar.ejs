<nav class="navbar navbar-expand-md sticky-top modern-navbar">
  <div class="container-fluid px-lg-4">
    <!-- Brand Logo -->
    <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
      <span class="brand-icon-wrapper">
        <i class="fa-regular fa-compass brand-icon"></i>
      </span>
      <span class="brand-name">wanderlust</span>
    </a>

    <!-- Mobile Toggler -->
    <button class="navbar-toggler border-0 shadow-none p-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <!-- Left Nav Links -->
      <div class="navbar-nav me-auto">
        <a class="nav-link nav-pill-link" href="/listings">
          <i class="fa-solid fa-compass me-1"></i> Explore
        </a>
      </div>

      <!-- Center Search Bar -->
      <div class="navbar-nav mx-auto my-2 my-md-0">
        <form class="d-flex search-wrapper" role="search" action="/listings" method="GET">
          <div class="search-input-box">
            <i class="fa-solid fa-magnifying-glass search-leading-icon"></i>
            <input 
              class="form-control search-inp" 
              id="liveSearchInput"
              name="q"
              type="search" 
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
              placeholder="Search destinations, cities, titles..." 
              autocomplete="off"
            />
            <button class="btn btn-search" type="submit" aria-label="Search">
              <span>Search</span>
              <i class="fa-solid fa-arrow-right search-btn-arrow"></i>
            </button>
          </div>
        </form>
      </div>

      <!-- Right Nav Links -->
      <div class="navbar-nav ms-auto align-items-md-center gap-2">
        <a class="nav-link host-btn" href="/listings/new">
          <i class="fa-solid fa-house-chimney me-1"></i> Airbnb your home
        </a>

        <% if (!currUser) { %>
          <div class="auth-pill-group">
            <a class="btn btn-sm btn-outline-auth" href="/signup">Sign up</a>
            <a class="btn btn-sm btn-primary-auth" href="/login">Log in</a>
          </div>
        <% } %>

        <% if (currUser) { %>
          <div class="user-profile-badge d-flex align-items-center gap-2">
            <div class="user-avatar">
              <%= currUser.username.charAt(0).toUpperCase() %>
            </div>
            <span class="user-name d-none d-lg-inline">@<%= currUser.username %></span>
            <a class="btn btn-sm btn-logout" href="/logout" title="Log out">
              <i class="fa-solid fa-arrow-right-from-bracket"></i>
              <span class="d-none d-md-inline ms-1">Log out</span>
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
